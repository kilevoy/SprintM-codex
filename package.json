{
  "name": "sprintm",
  "version": "0.1.0",
  "description": "Калькулятор ангаров ИНСИ «Спринт М» — расчёт сечений, ведомость материалов, стоимость",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "check:references": "node scripts/check_reference_drift.mjs",
    "check:wall-purlin-scenarios": "node scripts/oracle/validate_wall_purlin_scenarios.mjs",
    "update:references": "node scripts/check_reference_drift.mjs --update",
    "check:parity-baseline": "node scripts/oracle/check_baseline.mjs",
    "check:wall-purlin-parity": "vite-node scripts/oracle/compare_wall_purlin_calculator.mjs -- scripts/oracle/expected/wall-purlin-calculator.json",
    "check:wall-purlin-objects": "vite-node scripts/oracle/compare_wall_purlin_objects.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run check:references && npm run check:wall-purlin-scenarios && npm run check:wall-purlin-parity && npm run check:wall-purlin-objects && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "pdfjs-dist": "^6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
